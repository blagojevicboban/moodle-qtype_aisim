<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="question/type/aisim/db" VERSION="20261028" COMMENT="XMLDB file for Moodle question/type/aisim"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="qtype_aisim_options" COMMENT="Options for AI Simulation questions">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="questionid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Foreign key link to question.id"/>
        <FIELD NAME="simtype" TYPE="char" LENGTH="30" NOTNULL="true" DEFAULT="confusion_matrix" SEQUENCE="false" COMMENT="Type of AI simulation"/>
        <FIELD NAME="scenario" TYPE="char" LENGTH="30" NOTNULL="false" SEQUENCE="false" COMMENT="VET scenario or dataset preset"/>
        <FIELD NAME="targetparam1" TYPE="number" LENGTH="12" DECIMALS="4" NOTNULL="true" DEFAULT="0.0000" SEQUENCE="false" COMMENT="Primary target metric"/>
        <FIELD NAME="targetparam2" TYPE="number" LENGTH="12" DECIMALS="4" NOTNULL="true" DEFAULT="0.0000" SEQUENCE="false" COMMENT="Secondary target metric"/>
        <FIELD NAME="targettolerance" TYPE="number" LENGTH="12" DECIMALS="4" NOTNULL="true" DEFAULT="0.0000" SEQUENCE="false" COMMENT="Allowed tolerance"/>
        <FIELD NAME="simconfig" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Optional JSON simulation configuration"/>
        <FIELD NAME="correctfeedback" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="correctfeedbackformat" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="partiallycorrectfeedback" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="partiallycorrectfeedbackformat" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="incorrectfeedback" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="incorrectfeedbackformat" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="shownumcorrect" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id" COMMENT="Primary key"/>
        <KEY NAME="question" TYPE="foreign-unique" FIELDS="questionid" REFTABLE="question" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>

